# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# CoinMarketCal Configuration
COINMARKETCAL_API_KEY=your-coinmarketcal-api-key-here

# Telegram Configuration (for Telethon)
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_PHONE=your-phone-number-international-format

# Twitter/X Configuration (for Scweet)
# Get auth_token from browser: F12 -> Application -> Cookies -> https://x.com -> auth_token
TWITTER_AUTH_TOKEN=your-twitter-auth-token
TWITTER_PROXY=optional-proxy-url

# Reddit Configuration (for PRAW)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=llm4crypto/1.0 by LLM4Crypto

# Selenium/WebDriver Configuration
CHROMEDRIVER_PATH=path/to/your/edgedriver.exe
CHROME_BINARY_PATH=optional-chrome-binary-path